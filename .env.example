# Polymarket wallet private key (export from Polymarket → Cash → ··· → Export Private Key)
POLY_PRIVATE_KEY=

# Polymarket signing address (derived from private key)
POLY_WALLET_ADDRESS=
# Polymarket funder/proxy address (shown in Relayer API Keys section)
POLY_FUNDER_ADDRESS=

# Free tier API keys
NEWS_API_KEY=         # https://newsapi.org (free: 100 req/day)
ODDS_API_KEY=         # https://the-odds-api.com (free: 500 req/month)

# Bot settings
BOT_BUDGET_USDC=10.0         # starting budget in USDC
BOT_MAX_POSITION_PCT=0.30    # max % of budget per trade (30%)
BOT_KELLY_FRACTION=0.25      # fractional Kelly (conservative: 1/4)
BOT_MIN_EDGE=0.05            # minimum edge to place a bet (5%)
BOT_SCAN_INTERVAL_SEC=300    # how often to scan markets (5 min)

# Real Polymarket orders only when explicitly enabled (default: dry run)
LIVE_TRADING=0

# ─── Solana multi-agent bot — PAPER ONLY (no keys needed) ───
PAPER_START_USDC=100
PAPER_CYCLE_SEC=300
PAPER_AUTOSTART=0
PAPER_DB_PATH=./paper.db
RISK_MAX_POSITION_PCT=0.10
RISK_MAX_EXPOSURE_PCT=0.50
RISK_MAX_POSITIONS=4
RISK_MAX_DAILY_LOSS_PCT=0.05
SAFETY_MIN_PAIR_AGE_H=24
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=
# Optional LLM research/debate (veto-only)
ANTHROPIC_API_KEY=
DEBATE_MODEL=claude-opus-5-5
DEBATE_MCP_SERVERS=
