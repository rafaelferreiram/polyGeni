# Polymarket wallet private key (export from Polymarket → Cash → ··· → Export Private Key)
POLY_PRIVATE_KEY=

# Polymarket signing address (derived from private key)
POLY_WALLET_ADDRESS=
# Polymarket funder/proxy address (shown in Relayer API Keys section)
POLY_FUNDER_ADDRESS=

# Free tier API keys
NEWS_API_KEY=         # https://newsapi.org (free: 100 req/day)
ODDS_API_KEY=         # https://the-odds-api.com (free: 500 req/month)

# Bot settings
BOT_BUDGET_USDC=10.0         # starting budget in USDC
BOT_MAX_POSITION_PCT=0.30    # max % of budget per trade (30%)
BOT_KELLY_FRACTION=0.25      # fractional Kelly (conservative: 1/4)
BOT_MIN_EDGE=0.05            # minimum edge to place a bet (5%)
BOT_SCAN_INTERVAL_SEC=300    # how often to scan markets (5 min)

# Real Polymarket orders only when explicitly enabled (default: dry run). Separate from the Hyperliquid LIVE_TRADING.
POLY_LIVE_TRADING=0

# ─── Solana multi-agent bot — PAPER ONLY (no keys needed) ───
PAPER_START_USDC=100
PAPER_CYCLE_SEC=300
PAPER_AUTOSTART=0
PAPER_DB_PATH=./paper.db
RISK_MAX_POSITION_PCT=0.10
RISK_MAX_EXPOSURE_PCT=0.50
RISK_MAX_POSITIONS=4
RISK_MAX_DAILY_LOSS_PCT=0.05
SAFETY_MIN_PAIR_AGE_H=24
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PAPER_STRATEGIES=mean_reversion          # add ",momentum" to re-enable (it lost in every backtest)
RISK_MAX_ENTRIES_PER_DAY=6
HL_ENABLED=1
HL_MARKETS=BTC,ETH,SOL,xyz:GOLD,xyz:SILVER
MARKET_PROFILES=                         # JSON override, e.g. {"hyperliquid": {"max_pos_pct": 0.15, "stop_mult": 1.5}}
PAPER_TRUSTED_CLIENTS=127.0.0.1,::1      # loopback only; state-changing API needs X-Paper-Token too
PAPER_API_TOKEN=                         # optional fixed token (random per process if empty)
JUPITER_API_KEY=
# Optional LLM research/debate (veto-only)
ANTHROPIC_API_KEY=
DEBATE_MODEL=claude-opus-5-5
DEBATE_MCP_SERVERS=

# ─── Hyperliquid REAL trading (testnet first). The API wallet can trade but cannot withdraw. ───
HL_NETWORK=testnet                  # testnet | mainnet (mainnet also needs LIVE_TRADING=1)
HL_ACCOUNT_ADDRESS=                 # your MetaMask 0x address (public)
HL_API_WALLET_KEY=                  # API wallet private key from Hyperliquid → More → API. Never share it.
LIVE_MAX_CAPITAL_USD=20
LIVE_MAX_POSITION_USD=12            # Hyperliquid minimum order is $10
LIVE_MAX_POSITIONS=1
LIVE_MAX_DAILY_LOSS_PCT=0.10
HL_LIVE_MARKETS=BTC,ETH,SOL,xyz:GOLD,xyz:SILVER

# ─── LLM decisions and model arena (need ANTHROPIC_API_KEY) ───
ARENA_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
ARENA_CYCLE_SEC=900

# ─── Profitability guards ───
LLM_MONTHLY_BUDGET_USD=5            # hard cap on AI spend per month; then only the free rules bot trades
LLM_PREFILTER=1                     # call the AI only when there is a dip inside an uptrend
LLM_BOT_MAX_NET_LOSS_USD=1          # auto-pause an AI bot whose cost exceeds its gains by this
VPS_MONTHLY_USD=0                   # server cost, subtracted in the net-profit panel
# default team is cheap: rules (free) + Haiku. Add Sonnet/Opus/Fable only when capital justifies their cost.
